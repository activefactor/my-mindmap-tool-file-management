# このファイルは .env のサンプル（ダミー値）です。
# 実際の値を入れた .env は Git にコミットしないでください（.gitignore で除外済み）。
#
# ローカル開発（docker-compose）で使う場合は、DB_HOST を "mysql"（docker-compose の
# サービス名）に変更してください。本番（heteml）では同一ホスト上で動作するため
# "localhost" のままで問題ありません。

# アプリ
APP_ENV=local
APP_URL=http://localhost:8080

# データベース
DB_HOST=mysql
DB_NAME=mindmap
DB_USER=mindmap
DB_PASSWORD=mindmap

# Google OAuth（Step 3 で使用。ローカル開発用のクライアントID/シークレットを別途登録する）
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Microsoft OAuth（Step 3 で使用）
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=dummy-secret
MS_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback
MS_TENANT=common

# セッション
SESSION_IDLE_TIMEOUT_MINUTES=60

# ゴミ箱（FR-14）
TRASH_RETENTION_DAYS=30

# 監査ログ
AUDIT_LOG_RETENTION_DAYS=365

# 初期管理者ブートストラップ（db/seed.php が使用。Step 2 で実装。投入後は空にしてよい）
INITIAL_ADMIN_EMAIL=admin@example.co.jp
INITIAL_ALLOWED_DOMAIN=example.co.jp
